# Скопировать в .env локально и/или прописать эти же переменные в Amvera (Настройки → Переменные окружения).
# .env НЕ коммитить (см. .gitignore) — секреты не должны попадать в репозиторий (договор, раздел 12).

DJANGO_SETTINGS_MODULE=config.settings.dev

SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://best-season.online

# PostgreSQL (локально — см. значения по умолчанию в settings/base.py, они совпадают с локальной БД)
DB_NAME=best_season
DB_USER=best_season_user
DB_PASSWORD=dev_local_only
DB_HOST=127.0.0.1
DB_PORT=5432

# Уведомления по заявкам (раздел 7 ТЗ)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@best-season.online
NOTIFY_EMAIL=

# Виджет Контур.Отеля — см. 03-kontur-widget.md, ждём hotelId от Софии
KONTUR_HOTEL_ID=
